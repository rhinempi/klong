def merge_paired_reads():
    if not opt.merge_pairs or not (opt.pe1 or opt.pe12):
        return

    output_tmp = os.path.join(opt.out_dir, 'tmp')
    mkdir_if_not_exists(output_tmp)
    flash_dir = os.path.join(output_tmp, 'flash')
    mkdir_if_not_exists(flash_dir)
    manifest = os.path.join(flash_dir, 'merged.json')
    if check_point._logged_checkpoint is not None and os.path.exists(manifest):
        with open(manifest) as f:
            outputs = json.load(f)
        if all(os.path.isfile(path) for path in outputs):
            logger.info('Reuse merged FASTA output in %s', flash_dir)
            return

    # Independent completion marker, leaving assembly checkpoint numbering intact.
    remove_if_exists(manifest)
    outputs = []
    inputs = [(False, pair) for pair in zip(opt.pe1, opt.pe2)]
    inputs += [(True, (path,)) for path in opt.pe12]
    for i, (interleaved, paths) in enumerate(inputs):
        with tempfile.TemporaryDirectory(dir=opt.temp_dir, prefix='flash-') as work_dir:
            input_paths = []
            for j, path in enumerate(paths):
                if path.endswith('.bz2'):
                    unpacked = os.path.join(work_dir, 'input.{}.fastq'.format(j))
                    with bz2.open(path, 'rb') as source, open(unpacked, 'wb') as dest:
                        shutil.copyfileobj(source, dest)
                    input_paths.append(unpacked)
                else:
                    input_paths.append(path)
            prefix = 'library.{}'.format(i)
            cmd = [opt.megahit_core, 'flash', '-t', str(opt.num_cpu_threads),
                   '-m', str(opt.flash_min_overlap), '-M', str(opt.flash_max_overlap),
                   '-x', str(opt.flash_max_mismatch_density),
                   '-p', str(opt.flash_phred_offset), '-d', work_dir, '-o', prefix]
            if interleaved:
                cmd.append('--interleaved-input')
            cmd += input_paths
            run_sub_command(cmd, 'Merge paired-end library {} with FLASH'.format(i), verbose=True)
            output = os.path.join(flash_dir, prefix + '.merged.fa.gz')
            try:
                fastq_to_fasta_gz(os.path.join(work_dir, prefix + '.extendedFrags.fastq'),
                                  output + '.tmp')
                os.replace(output + '.tmp', output)
            finally:
                remove_if_exists(output + '.tmp')
            outputs.append(output)
            logger.info('Merged FASTA: %s', output)
    with open(manifest + '.tmp', 'w') as f:
        json.dump(outputs, f)
    os.replace(manifest + '.tmp', manifest)


def fastq_to_fasta_gz(source_path, output_path):
    # FLASH emits normalized four-line FASTQ records, even for multiline inputs.
    with open(source_path, 'rb') as source, gzip.open(output_path, 'wb') as dest:
        while True:
            header = source.readline()
            if not header:
                break
            sequence = source.readline().rstrip(b'\r\n')
            separator = source.readline()
            quality = source.readline().rstrip(b'\r\n')
            if not header.startswith(b'@') or not separator.startswith(b'+') or len(sequence) != len(quality):
                raise Usage('Invalid merged FASTQ output from FLASH: ' + source_path)
            dest.write(b'>' + header[1:].rstrip(b'\r\n') + b'\n' + sequence + b'\n')


def file_signature(path):
    if not os.path.isfile(path):
        raise Usage('Missing input file: ' + path)
    info = os.stat(path)
    return {'path': os.path.abspath(path), 'size': info.st_size, 'mtime_ns': info.st_mtime_ns}


def map_merged_reads(cur_k):
    if not opt.merge_pairs:
        return
    merged_manifest = os.path.join(opt.out_dir, 'tmp', 'flash', 'merged.json')
    if not os.path.isfile(merged_manifest):
        logger.info('No merged-read libraries to map at k = %d', cur_k)
        return
    with open(merged_manifest) as source:
        queries = json.load(source)
    if not queries:
        return
    reference = contig_ends_path(cur_k)
    if not os.path.isfile(reference):
        raise Usage('Cannot map merged reads: missing contig ends ' + reference)
    if os.path.getsize(reference) == 0:
        logger.warning('Skip merged-read mapping: no contig ends at k = %d', cur_k)
        return

    output_dir = os.path.join(opt.out_dir, 'tmp', 'k' + str(cur_k), 'flank_mapping')
    os.makedirs(output_dir, exist_ok=True)
    manifest = os.path.join(output_dir, 'mapping.json')
    parameters = ['-x', 'sr', '-a', '-Y', '-t', str(opt.num_cpu_threads), '-I', '55G']

    configuration = {'version': check_output([opt.megahit_core, 'minimap2', '--version']),
                     'parameters': parameters, 'reference': file_signature(reference),
                     'queries': [file_signature(path) for path in queries]}
    outputs = [os.path.join(output_dir, 'library.{}.sam'.format(i)) for i in range(len(queries))]
    if check_point._logged_checkpoint is not None and os.path.isfile(manifest):
        with open(manifest) as source:
            completed = json.load(source)
        if (completed.get('configuration') == configuration and completed.get('outputs') == outputs
                and all(os.path.isfile(path) and os.path.getsize(path) > 0 for path in outputs)):
            logger.info('Reuse merged-read alignments at k = %d', cur_k)
            return

    # This stage has its own completion marker to preserve assembly checkpoints.
    remove_if_exists(manifest)
    for query, output in zip(queries, outputs):
        cmd = [opt.megahit_core, 'minimap2'] + parameters + ['-o', output + '.tmp', reference, query]
        try:
            run_sub_command(cmd, 'Map merged reads to k = %d contig ends: %s' % (cur_k, query), verbose=True)
            os.replace(output + '.tmp', output)
        finally:
            remove_if_exists(output + '.tmp')
    with open(manifest + '.tmp', 'w') as dest:
        json.dump({'configuration': configuration, 'outputs': outputs}, dest, indent=2)
    os.replace(manifest + '.tmp', manifest)


def extend_contig_ends(cur_k):
    if not opt.merge_pairs:
        return
    reference = contig_ends_path(cur_k)
    output_dir = os.path.join(opt.out_dir, 'tmp', 'k' + str(cur_k), 'flank_mapping')
    mapping_manifest = os.path.join(output_dir, 'mapping.json')
    if not os.path.isfile(mapping_manifest) or not os.path.isfile(reference) or os.path.getsize(reference) == 0:
        return
    with open(mapping_manifest) as source:
        mapping = json.load(source)
    if mapping.get('configuration', {}).get('reference') != file_signature(reference):
        raise Usage('Contig-end mappings are stale; rerun mapping before consensus.')
    alignments = mapping['outputs']
    output = os.path.join(os.path.dirname(reference), 'k{}.contig_ends.extended.fa'.format(cur_k))
    stats = os.path.join(output_dir, 'consensus.tsv')
    manifest = os.path.join(output_dir, 'consensus.json')
    configuration = {'algorithm': 'outward-plurality-extended-only-v2', 'reference': file_signature(reference),
                     'alignments': [file_signature(path) for path in alignments]}
    if check_point._logged_checkpoint is not None and os.path.isfile(manifest):
        with open(manifest) as source:
            completed = json.load(source)
        valid_output = False
        if os.path.isfile(output) and os.path.isfile(output + '.info'):
            try:
                with open(output + '.info') as source:
                    count, bases = map(int, source.read().split())
                valid_output = (count >= 0 and bases >= 0 and (count > 0) == (os.path.getsize(output) > 0)
                                and (count > 0 or bases == 0))
            except (OSError, ValueError):
                pass
        if (completed == configuration and valid_output and os.path.isfile(stats)
                and os.path.getsize(stats) > 0):
            logger.info('Reuse contig-end consensus at k = %d', cur_k)
            return output
    remove_if_exists(manifest)
    cmd = [opt.megahit_core, 'endconsensus', reference, output + '.tmp', stats + '.tmp'] + alignments
    try:
        run_sub_command(cmd, 'Build outward contig-end consensus at k = %d' % cur_k, verbose=True)
        os.replace(output + '.tmp', output)
        os.replace(output + '.tmp.info', output + '.info')
        os.replace(stats + '.tmp', stats)
    finally:
        remove_if_exists(output + '.tmp')
        remove_if_exists(output + '.tmp.info')
        remove_if_exists(stats + '.tmp')
    with open(manifest + '.tmp', 'w') as dest:
        json.dump(configuration, dest, indent=2)
    os.replace(manifest + '.tmp', manifest)
    return output


def remove_temporary_files():
    if opt.keep_tmp_files or not os.path.exists(opt.temp_dir):
        return
    output_tmp = os.path.join(opt.out_dir, 'tmp')
    if os.path.abspath(opt.temp_dir) == os.path.abspath(output_tmp):
        def remove_entry(entry):
            if entry.is_dir(follow_symlinks=False):
                shutil.rmtree(entry.path)
            else:
                os.remove(entry.path)

        for entry in os.scandir(opt.temp_dir):
            if opt.merge_pairs and entry.name == 'flash' and entry.is_dir(follow_symlinks=False):
                continue
            if (entry.name.startswith('k') and entry.name[1:].isdigit()
                    and entry.is_dir(follow_symlinks=False)):
                children = list(os.scandir(entry.path))
                keep = {child.name for child in children
                        if (child.name.endswith(('.contig_ends.fa', '.contig_ends.extended.fa',
                                                 '.contig_ends.extended.fa.info'))
                            and child.is_file(follow_symlinks=False))
                        or (opt.merge_pairs and child.name == 'flank_mapping'
                            and child.is_dir(follow_symlinks=False))}
                if not keep:
                    remove_entry(entry)
                else:
                    for child in children:
                        if child.name not in keep:
                            remove_entry(child)
            else:
                remove_entry(entry)
        if not os.listdir(opt.temp_dir):
            os.rmdir(opt.temp_dir)
    else:
        shutil.rmtree(opt.temp_dir)


def inpipe_cmd(file_name):
    if file_name.endswith('.gz'):
        return 'gzip -cd ' + file_name
    elif file_name.endswith('.bz2'):
        return 'bzip2 -cd ' + file_name
    else:
        return ''


@check_point
def create_library_file():
    with open(opt.read_lib_path, 'w') as lib:
        for i, file_name in enumerate(opt.pe12):
            print(file_name, file=lib)
            if inpipe_cmd(file_name) != '':
                print('interleaved ' + os.path.join(opt.temp_dir, 'inpipe.pe12.' + str(i)), file=lib)
            else:
                print('interleaved ' + file_name, file=lib)

        for i, (file_name1, file_name2) in enumerate(zip(opt.pe1, opt.pe2)):
            print(','.join([file_name1, file_name2]), file=lib)

            if inpipe_cmd(file_name1) != '':
                f1 = os.path.join(opt.temp_dir, 'inpipe.pe1.' + str(i))
            else:
                f1 = file_name1

            if inpipe_cmd(file_name2) != '':
                f2 = os.path.join(opt.temp_dir, 'inpipe.pe2.' + str(i))
            else:
                f2 = file_name2

            print('pe ' + f1 + ' ' + f2, file=lib)

        for i, file_name in enumerate(opt.se):
            print(file_name, file=lib)
            if inpipe_cmd(file_name) != '':
                print('se ' + os.path.join(opt.temp_dir, 'inpipe.se.' + str(i)), file=lib)
            else:
                print('se ' + file_name, file=lib)


@check_point
def build_library():
    cmd = [opt.megahit_core, 'buildlib', opt.read_lib_path, opt.read_lib_path,
           str(opt.num_cpu_threads)]
    fifos = list()
    pipes = list()

    def create_fifo(read_type, num, command):
        fifo_path = os.path.join(opt.temp_dir, 'inpipe.{0}.{1}'.format(read_type, num))
        remove_if_exists(fifo_path)
        os.mkfifo(fifo_path)
        fifos.append(fifo_path)
        p = subprocess.Popen('{0} > {1}'.format(command, fifo_path), shell=True, preexec_fn=os.setsid)
        pipes.append(p)

    try:
        # create inpipe
        for i in range(len(opt.pe12)):
            if inpipe_cmd(opt.pe12[i]) != '':
                create_fifo('pe12', i, inpipe_cmd(opt.pe12[i]))

        for i in range(len(opt.pe1)):
            if inpipe_cmd(opt.pe1[i]) != '':
                create_fifo('pe1', i, inpipe_cmd(opt.pe1[i]))

            if inpipe_cmd(opt.pe2[i]) != '':
                create_fifo('pe2', i, inpipe_cmd(opt.pe2[i]))

        for i in range(len(opt.se)):
            if inpipe_cmd(opt.se[i]) != '':
                create_fifo('se', i, inpipe_cmd(opt.se[i]))

        run_sub_command(cmd, 'Convert reads to binary library', verbose=True)

        for p in pipes:
            pipe_ret = p.wait()
            if pipe_ret != 0:
                logger.error('Error occurs when reading inputs')
                exit(pipe_ret)

    finally:
        for p in pipes:
            if p.poll() is None:
                os.killpg(p.pid, signal.SIGTERM)
        for f in fifos:
            remove_if_exists(f)


def get_max_read_len():
    ret = 0
    with open(opt.read_lib_path + '.lib_info') as read_info:
        for info in read_info.readlines()[2::2]:
            ret = max(ret, int(info.split()[2]))
    read_info.close()
    return ret


def set_max_k_by_lib():
    if not opt.auto_k or len(opt.k_list) == 1:
        return False

    max_read_len = get_max_read_len()
    new_k_list = [k for k in opt.k_list if k < max_read_len + 20]
    if not new_k_list:
        return False
    else:
        opt.k_list = new_k_list
        opt.k_min = opt.k_list[0]
        opt.k_max = opt.k_list[-1]
        return True


