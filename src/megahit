def extract_contig_ends(cur_k, flank_length=290):
    if flank_length <= 0:
        raise Usage('Contig-end length must be positive.')
    source_path = contig_prefix(cur_k) + '.contigs.fa'
    if not os.path.isfile(source_path):
        raise Usage('Cannot extract contig ends: missing contigs ' + source_path)
    output_path = contig_ends_path(cur_k)
    output_dir = os.path.dirname(output_path)
    os.makedirs(output_dir, exist_ok=True)
    whole_count, split_count = 0, 0

    def write_record(dest, header, sequence):
        nonlocal whole_count, split_count
        if len(sequence) < 2 * flank_length:
            dest.write(header + '\n' + sequence + '\n')
            whole_count += 1
            return
        name = header[1:].split()[0]
        length = len(sequence)
        dest.write('>{}|start source_length={} region=1-{}\n{}\n'.format(
            name, length, flank_length, sequence[:flank_length]))
        dest.write('>{}|end source_length={} region={}-{}\n{}\n'.format(
            name, length, length - flank_length + 1, length, sequence[-flank_length:]))
        split_count += 1

    try:
        with open(source_path) as source, open(output_path + '.tmp', 'w') as dest:
            header, chunks = None, []
            for line in source:
                if line.startswith('>'):
                    if header is not None:
                        write_record(dest, header, ''.join(chunks))
                    header, chunks = line.rstrip('\r\n'), []
                    if not header[1:].strip():
                        raise Usage('Empty FASTA contig name in ' + source_path)
                elif line.strip():
                    if header is None:
                        raise Usage('FASTA sequence without a header in ' + source_path)
                    chunks.append(line.strip())
            if header is not None:
                write_record(dest, header, ''.join(chunks))
        if not os.path.isfile(output_path) or not filecmp.cmp(output_path + '.tmp', output_path, shallow=False):
            os.replace(output_path + '.tmp', output_path)
    finally:
        remove_if_exists(output_path + '.tmp')
    logger.info('Contig ends from k = %d: %d whole contigs, %d split contigs; output %s',
                cur_k, whole_count, split_count, output_path)
    return output_path


def pruned_short_contig_file(kmer_k, next_k):
    return contig_prefix(kmer_k) + '.lt_k%d_plus1.contigs.fa' % next_k


def pruned_long_contig_file(kmer_k, next_k):
    return contig_prefix(kmer_k) + '.ge_k%d_plus1.contigs.fa' % next_k


def split_contigs_by_next_k(cur_k, next_k):
    input_file = contig_prefix(cur_k) + '.contigs.fa'
    short_file = pruned_short_contig_file(cur_k, next_k)
    long_file = pruned_long_contig_file(cur_k, next_k)
    threshold = next_k + 1

    short_count = 0
    short_bases = 0
    long_count = 0
    long_bases = 0

    def write_record(out, header, seq):
        out.write(header)
        if not header.endswith('\n'):
            out.write('\n')
        out.write(seq + '\n')

    with open(short_file, 'w') as short_out, open(long_file, 'w') as long_out:
        if not os.path.exists(input_file):
            logger.warning('Skip contig split for k = %d: %s missing',
                           cur_k, input_file)
            return short_file, long_file

        header = None
        seq_chunks = []
        with open(input_file) as in_contigs:
            for line in in_contigs:
                if line.startswith('>'):
                    if header is not None:
                        seq = ''.join(seq_chunks)
                        if len(seq) < threshold:
                            write_record(short_out, header, seq)
                            short_count += 1
                            short_bases += len(seq)
                        else:
                            write_record(long_out, header, seq)
                            long_count += 1
                            long_bases += len(seq)
                    header = line
                    seq_chunks = []
                else:
                    seq_chunks.append(line.strip())

        if header is not None:
            seq = ''.join(seq_chunks)
            if len(seq) < threshold:
                write_record(short_out, header, seq)
                short_count += 1
                short_bases += len(seq)
            else:
                write_record(long_out, header, seq)
                long_count += 1
                long_bases += len(seq)

    logger.info('Split k = %d contigs at length %d: short %d contigs/%d bp, long %d contigs/%d bp',
                cur_k, threshold, short_count, short_bases, long_count, long_bases)
    return short_file, long_file


