                    'Build full read-counted graph for k = %d ' % kmer_k)


def remove_edge_prefix(prefix):
    directory = os.path.dirname(prefix)
    base = os.path.basename(prefix) + '.edges.'
    if os.path.exists(directory):
        for name in os.listdir(directory):
            if name.startswith(base):
                remove_if_exists(os.path.join(directory, name))
    remove_if_exists(prefix + '.edges.info')


def promote_edge_prefix(tmp_prefix, final_prefix):
    remove_edge_prefix(final_prefix)
    directory = os.path.dirname(tmp_prefix)
    tmp_base = os.path.basename(tmp_prefix) + '.edges.'
    final_base = os.path.basename(final_prefix) + '.edges.'
    for name in os.listdir(directory):
        if not name.startswith(tmp_base):
            continue
        suffix = name[len(tmp_base):]
        # Move only real edge shards (for example .0 or .0.txt); metadata is
        # promoted after all shards so the graph prefix is complete atomically.
        shard_id = suffix[:-4] if suffix.endswith('.txt') else suffix
        if not shard_id.isdigit():
            continue
        os.rename(os.path.join(directory, name),
                  os.path.join(directory, final_base + suffix))
    os.rename(tmp_prefix + '.edges.info', final_prefix + '.edges.info')


def reduce_edges_for_k(short_k, long_k):
    short_prefix = current_edge_prefix(short_k)
    long_prefix = read_count_prefix_path(long_k)
    if not edge_prefix_exists(short_prefix) or not edge_prefix_exists(long_prefix):
        logger.warning('Skip edge reduction for k = %d using k = %d: binary edge files missing',
                       short_k, long_k)
        return None

    output_prefix = reduced_edge_prefix(short_k)
    remove_edge_prefix(output_prefix)
    reduce_opt = ['--mode', 'reduce',
                  '--short_prefix', short_prefix,
                  '--long_prefix', long_prefix,
                  '--output_prefix', output_prefix,
                  '--short_k', str(short_k),
                  '--long_k', str(long_k),
                  '--num_cpu_threads', str(opt.num_cpu_threads),
                  '--human_readable', '1' if opt.human_readable_output else '0',
                  '--max_bloom_gb', '60',
                  '--reserve_gb', '1']
    run_sub_command([opt.megahit_core, 'prefixbf'] + reduce_opt,
                    'Reduce edges for k = %d using k = %d ' % (short_k, long_k))
    return output_prefix


def merge_contig_edges_into_next_k(short_k, long_k):
    long_prefix = read_count_prefix_path(long_k)
    if not edge_prefix_exists(long_prefix):
        logger.warning('Skip edge merge for k = %d: read-counted edge files missing', long_k)
        return None

    merge_contigs = pruned_short_contig_file(short_k, long_k)
    if not os.path.exists(merge_contigs):
        logger.warning('Short pruned contig file %s missing; falling back to %s',
                       merge_contigs, contig_prefix(short_k) + '.contigs.fa')
        merge_contigs = contig_prefix(short_k) + '.contigs.fa'

    merge_long_contigs = pruned_long_contig_file(short_k, long_k)
    if not os.path.exists(merge_long_contigs):
        logger.warning('Long pruned contig file %s missing; long-contig edge scan disabled',
                       merge_long_contigs)
        merge_long_contigs = None

    output_prefix = merged_edge_prefix(long_k)
    remove_edge_prefix(output_prefix)
    merge_opt = ['--mode', 'merge',
                 '--long_prefix', long_prefix,
                 '--output_prefix', output_prefix,
                 '--contig', merge_contigs,
                 '--short_k', str(short_k),
                 '--long_k', str(long_k),
                 '--num_cpu_threads', str(opt.num_cpu_threads),
                 '--human_readable', '1' if opt.human_readable_output else '0']
    if merge_long_contigs is not None:
        merge_opt += ['--long_contig', merge_long_contigs]
    run_sub_command([opt.megahit_core, 'prefixbf'] + merge_opt,
                    'Merge k = %d assembly edges into k = %d ' % (short_k, long_k))
    return output_prefix


def build_graph_from_edge_prefix(kmer_k, input_prefix=None):
    if input_prefix is None:
        input_prefix = current_edge_prefix(kmer_k)
    output_prefix = assembly_graph_prefix(kmer_k)
    build_opt = ['--host_mem', str(opt.host_mem),
                 '--mem_flag', str(opt.mem_flag),
                 '--output_prefix', output_prefix,
                 '--num_cpu_threads', str(opt.num_cpu_threads),
                 '-k', str(kmer_k),
                 '--kmer_from', '0',
                 '--input_prefix', input_prefix]
    run_sub_command([opt.megahit_core, 'seq2sdbg'] + build_opt,
                    'Build graph for k = %d from %s ' % (kmer_k, input_prefix))
    return output_prefix


def build_first_graph(use_reduction_edges):
    common_option = ['-k', str(opt.k_min),
                     '-m', str(opt.min_count),
                     '--host_mem', str(opt.host_mem),
                     '--mem_flag', str(opt.mem_flag),
                     '--output_prefix', graph_prefix(opt.k_min),
                     '--num_cpu_threads', str(opt.num_cpu_threads),
                     '--read_lib_file', opt.read_lib_path]

    if opt.kmin_1pass and use_reduction_edges:
        logger.warning('Reduced-edge iteration ignores --kmin-1pass and counts k-min edges first')
    if opt.kmin_1pass and not use_reduction_edges:
        build_first_graph_1pass(common_option)
        return True

    count_mink(common_option)
    return False


@check_point
def build_graph(kmer_k, kmer_from):
    build_comm_opt = ['--host_mem', str(opt.host_mem),
                      '--mem_flag', str(opt.mem_flag),
                      '--output_prefix', graph_prefix(kmer_k),
                      '--num_cpu_threads', str(opt.num_cpu_threads),
                      '-k', str(kmer_k),
                      '--kmer_from', str(kmer_from)]

    build_cmd = [opt.megahit_core, 'seq2sdbg'] + build_comm_opt

    file_size = 0

    if os.path.exists(graph_prefix(kmer_k) + '.edges.0'):
        build_cmd += ['--input_prefix', graph_prefix(kmer_k)]
        file_size += os.path.getsize(graph_prefix(kmer_k) + '.edges.0')
        tid = 1
        while os.path.exists(graph_prefix(kmer_k) + '.edges.' + str(tid)):
            file_size += os.path.getsize(graph_prefix(kmer_k) + '.edges.' + str(tid))
            tid += 1

    if os.path.exists(contig_prefix(kmer_from) + '.addi.fa'):
        build_cmd += ['--addi_contig', contig_prefix(kmer_from) + '.addi.fa']
        file_size += os.path.getsize(contig_prefix(kmer_from) + '.addi.fa')

    if not opt.no_local and os.path.exists(contig_prefix(kmer_from) + '.local.fa'):
        build_cmd += ['--local_contig', contig_prefix(kmer_from) + '.local.fa']
        file_size += os.path.getsize(contig_prefix(kmer_from) + '.local.fa')

    if os.path.exists(contig_prefix(kmer_from) + '.contigs.fa'):
        build_cmd += ['--contig', contig_prefix(kmer_from) + '.contigs.fa']
        build_cmd += ['--bubble', contig_prefix(kmer_from) + '.bubble_seq.fa']

    if file_size == 0 and kmer_from != 0:
        raise EarlyTerminate(kmer_from)

    if not opt.no_mercy and kmer_k == opt.k_min:
        build_cmd.append('--need_mercy')

    run_sub_command(build_cmd, 'Build graph for k = %d ' % kmer_k)

    if not opt.keep_tmp_files:
        remove_temp_after_build(kmer_k)


@check_point
def iterate(cur_k, step):
    next_k = cur_k + step
    iterate_cmd = [opt.megahit_core, 'iterate',
                   '-c', contig_prefix(cur_k) + '.contigs.fa',
                   '-b', contig_prefix(cur_k) + '.bubble_seq.fa',
                   '-t', str(opt.num_cpu_threads),
                   '-k', str(cur_k),
                   '-s', str(step),
                   '-o', graph_prefix(next_k),
                   '-r', opt.read_lib_path + '.bin']

    run_sub_command(iterate_cmd, 'Extract iterative edges from k = %d to %d ' % (cur_k, next_k))


@check_point
def assemble(cur_k, graph_input_prefix=None, next_k=None):
    preserve_intermediate_contigs = next_k is not None
    if preserve_intermediate_contigs:
        min_standalone = 0
        prune_level = 0
        merge_len = 0
        bubble_level = 0
        cleaning_rounds = 1
        min_depth = 0
        max_tip_len = 0
        if opt.debug_assembly:
            logger.warning('Debug assembly for k = %d: pruning and next-k length threshold disabled', cur_k)
        else:
            logger.info('Intermediate assembly for k = %d: pruning disabled so short contigs can be split before merge', cur_k)
    else:
        min_standalone = max(min(opt.k_max * 3 - 1, int(opt.min_contig_len * 1.5)), opt.min_contig_len)
        if opt.max_tip_len >= 0:
            min_standalone = max(opt.max_tip_len + opt.k_max - 1, opt.min_contig_len)
        prune_level = opt.prune_level
        merge_len = int(opt.merge_len)
        bubble_level = opt.bubble_level
        cleaning_rounds = opt.cleaning_rounds
        min_depth = opt.prune_depth
        if opt.max_tip_len == -1 and cur_k * 3 - 1 > opt.min_contig_len * 1.5:
            max_tip_len = max(1, opt.min_contig_len * 1.5 + 1 - cur_k)
        else:
            max_tip_len = opt.max_tip_len

    if graph_input_prefix is None:
        graph_input_prefix = assembly_graph_prefix(cur_k)

    assembly_cmd = [opt.megahit_core, 'assemble',
                    '-s', graph_input_prefix,
                    '-o', contig_prefix(cur_k),
                    '-t', str(opt.num_cpu_threads),
                    '--min_standalone', str(min_standalone),
                    '--prune_level', str(prune_level),
                    '--merge_len', str(merge_len),
                    '--merge_similar', str(opt.merge_similar),
                    '--cleaning_rounds', str(cleaning_rounds),
                    '--disconnect_ratio', str(opt.disconnect_ratio),
                    '--low_local_ratio', str(opt.low_local_ratio),
                    '--min_depth', str(min_depth),
                    '--bubble_level', str(bubble_level),
                    '--max_tip_len', str(max_tip_len)]

    if cur_k < opt.k_max and not preserve_intermediate_contigs:
        assembly_cmd.append('--careful_bubble')

    if cur_k == opt.k_max:
        assembly_cmd.append('--is_final_round')
        if opt.human_readable_output:
            assembly_cmd += ['--pruned_unitig',
                             contig_prefix(cur_k) + '.pruned_unitigs.fa']

    if opt.no_local:
        assembly_cmd.append('--output_standalone')

    run_sub_command(assembly_cmd, 'Assemble contigs from SdBG for k = %d' % cur_k)

    if next_k is not None:
        split_contigs_by_next_k(cur_k, next_k)

    if (not opt.keep_tmp_files) and (cur_k != opt.k_max):
        remove_temp_after_assemble(cur_k)


@check_point
def local_assemble(cur_k, kmer_to):
    logger.info('Consensus local contigs for k = %d -> %d', cur_k, kmer_to)
    extended = None
    if opt.merge_pairs:
        extract_contig_ends(cur_k)
        map_merged_reads(cur_k)
        extended = extend_contig_ends(cur_k)
    else:
        logger.warning('Consensus local assembly requires --merge-pairs; writing empty local contigs for k = %d', cur_k)
    local_file = contig_prefix(cur_k) + '.local.fa'
    os.makedirs(opt.contig_dir, exist_ok=True)
    try:
        if extended is not None:
            shutil.copyfile(extended, local_file + '.tmp')
            shutil.copyfile(extended + '.info', local_file + '.info.tmp')
        else:
            with open(local_file + '.tmp', 'w'):
                pass
            with open(local_file + '.info.tmp', 'w') as dest:
                dest.write('0 0\n')
        os.replace(local_file + '.tmp', local_file)
        os.replace(local_file + '.info.tmp', local_file + '.info')
    finally:
        remove_if_exists(local_file + '.tmp')
        remove_if_exists(local_file + '.info.tmp')


@check_point
def merge_final(final_k):
    logger.info('Merging to output final contigs ')
    final_contig_name = os.path.join(opt.out_dir, 'final.contigs.fa')
    if opt.out_prefix != '':
        final_contig_name = os.path.join(opt.out_dir, opt.out_prefix + '.contigs.fa')

    rejected_contig_name = None
    if opt.human_readable_output:
        rejected_contig_name = os.path.splitext(final_contig_name)[0] + \
                               '.below_%d.fa' % opt.min_contig_len

    with open(final_contig_name, 'w') as final_contigs:
        filter_cmd = shlex.quote(opt.megahit_core) + ' filterbylen ' + \
                     str(opt.min_contig_len)
        if rejected_contig_name is not None:
            filter_cmd += ' ' + shlex.quote(rejected_contig_name)
        merge_cmd = 'cat ' + opt.contig_dir + '/*.final.contigs.fa ' + \
                    shlex.quote(contig_prefix(final_k) + '.contigs.fa') + \
                    ' | ' + filter_cmd
        p = subprocess.Popen(merge_cmd, shell=True, stdout=final_contigs, stderr=subprocess.PIPE)
        _, log = p.communicate()
        logger.info(log.rstrip().decode('utf-8'))
        ret_code = p.wait()

    if ret_code != 0:
        logger.error('Error occurs when merging final contigs, please refer to %s for detail' % opt.log_file_name)
        logger.error('Exit code %d' % ret_code)
        exit(ret_code)


def run_sub_command(cmd, msg, verbose=False):
    if opt.verbose:
        verbose = True
    logger.info(msg)
    logger.debug('command %s' % ' '.join(cmd))

    env = os.environ.copy()
    env['MEGAHIT_HUMAN_READABLE_OUTPUT'] = '1' if opt.human_readable_output else '0'
    p = subprocess.Popen(cmd, stderr=subprocess.PIPE, env=env)

    try:
        while True:
            line = p.stderr.readline().rstrip()
            if not line:
                break
            if verbose:
                logger.info(line)
            else:
                logger.debug(line)

        ret_code = p.wait()

        if ret_code != 0:
            logger.error('Error occurs, please refer to %s for detail' % opt.log_file_name)
            logger.error('Command: %s; Exit code %d' % (' '.join(cmd), ret_code))
            exit(ret_code)
    except KeyboardInterrupt:
        p.terminate()
        p.wait()
        exit(signal.SIGINT)


def main(argv=None):
    if argv is None:
        argv = sys.argv

    try:
        start_time = time.time()
        check_bin()
        parse_option(argv[1:])
        setup_output_dir()
        setup_logger()

        check_and_correct_option()

        check_reads()
        cpu_dispatch()
        opt.dump()

        create_library_file()
        build_library()
        merge_paired_reads()

        if set_max_k_by_lib():
            logger.info('k-max reset to: %d ' % opt.k_max)

        logger.info('Start assembly. Number of CPU threads %d ' % opt.num_cpu_threads)
        logger.info('k list: %s ' % ','.join(map(str, opt.k_list)))
        logger.info('Memory used: %d' % opt.host_mem)

        try:
            reduction_k_list = [k for k in opt.k_list if k <= REDUCTION_MAX_K]
            flanking_k_list = [k for k in opt.k_list if k > REDUCTION_MAX_K]
            first_graph_built = build_first_graph(bool(reduction_k_list))

            if reduction_k_list:
                logger.info('Using reduction/merge workflow through k = %d',
                            reduction_k_list[-1])
            else:
                logger.info('No requested k <= %d; using the original flanking workflow',
                            REDUCTION_MAX_K)

            for next_k_idx in range(1, len(reduction_k_list)):
                cur_k = reduction_k_list[next_k_idx - 1]
                next_k = reduction_k_list[next_k_idx]
                count_and_build_read_graph(next_k)
                reduced_prefix = reduce_edges_for_k(cur_k, next_k)
                graph_input = build_graph_from_edge_prefix(cur_k, reduced_prefix)
                assemble(cur_k, graph_input, next_k)
                merge_contig_edges_into_next_k(cur_k, next_k)

            if reduction_k_list:
                cur_k = reduction_k_list[-1]
                if cur_k == opt.k_min and len(reduction_k_list) == 1:
                    # No reduction preceded the handoff, so retain the normal
                    # first-k graph build (including mercy k-mers when enabled).
                    build_graph(cur_k, 0)
                    assemble(cur_k, graph_prefix(cur_k))
                else:
                    graph_input = build_graph_from_edge_prefix(
                        cur_k, current_edge_prefix(cur_k))
                    # A normal cleaned assembly at the handoff k emits the
                    # contig, bubble, and additional-contig inputs required by
                    # the original flanking iteration.
                    assemble(cur_k, graph_input)
                if not flanking_k_list or opt.no_local:
                    if flanking_k_list or opt.merge_pairs:
                        extract_contig_ends(cur_k)
                    map_merged_reads(cur_k)
                    extend_contig_ends(cur_k)
            else:
                cur_k = opt.k_min
                if not first_graph_built:
                    build_graph(cur_k, 0)
                assemble(cur_k, graph_prefix(cur_k))

            if flanking_k_list:
                logger.info('Switching to original flanking workflow after k = %d',
                            cur_k)

            for next_k in flanking_k_list:
                if next_k <= cur_k:
                    continue
                if not opt.no_local:
                    local_assemble(cur_k, next_k)

                iterate(cur_k, next_k - cur_k)
                build_graph(next_k, cur_k)
                assemble(next_k, graph_prefix(next_k))
                cur_k = next_k

            merge_final(opt.k_max)

        except EarlyTerminate as et:
            merge_final(et.kmer_size)

        remove_temporary_files()

        open(os.path.join(opt.out_dir, 'done'), 'w').close()

        if not opt.keep_tmp_files and opt.test_mode:
            shutil.rmtree(opt.out_dir)

        logger.info('ALL DONE. Time elapsed: %f seconds ' % (time.time() - start_time))

    except Usage as usg:
        print(sys.argv[0].split('/')[-1] + ': ' + str(usg.msg), file=sys.stderr)
        exit(1)


if __name__ == '__main__':
    main()
