# Optional compressor builds must never make the native workflow build fail.
set(PIGZ_HEX "")
set(PIGZ_SIZE 0)
if(ENABLE_PIGZ)
    file(MAKE_DIRECTORY "${PIGZ_BUILD_DIR}")
    set(PIGZ_BINARY "${PIGZ_BUILD_DIR}/pigz${EXE_SUFFIX}")
    file(REMOVE "${PIGZ_BINARY}")
    set(CONFIGURE_ARGS "${PIGZ_SOURCE}" "-DCMAKE_BUILD_TYPE=Release" "-DSTATIC_BUILD=${STATIC_PIGZ}")
    if(C_COMPILER)
        list(APPEND CONFIGURE_ARGS "-DCMAKE_C_COMPILER=${C_COMPILER}")
    endif()
    if(ZLIB_INCLUDE)
        list(APPEND CONFIGURE_ARGS "-DZLIB_INCLUDE_DIR=${ZLIB_INCLUDE}")
    endif()
    if(ZLIB_LIBRARY)
        list(APPEND CONFIGURE_ARGS "-DZLIB_LIBRARY=${ZLIB_LIBRARY}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" ${CONFIGURE_ARGS}
            WORKING_DIRECTORY "${PIGZ_BUILD_DIR}" RESULT_VARIABLE CONFIGURE_RESULT
            OUTPUT_VARIABLE CONFIGURE_OUTPUT ERROR_VARIABLE CONFIGURE_ERROR TIMEOUT 180)
    if(CONFIGURE_RESULT STREQUAL "0")
        execute_process(COMMAND "${CMAKE_COMMAND}" --build . --config Release --target pigz
                WORKING_DIRECTORY "${PIGZ_BUILD_DIR}" RESULT_VARIABLE BUILD_RESULT
                OUTPUT_VARIABLE BUILD_OUTPUT ERROR_VARIABLE BUILD_ERROR TIMEOUT 180)
        if(BUILD_RESULT STREQUAL "0" AND EXISTS "${PIGZ_BINARY}")
            execute_process(COMMAND "${PIGZ_BINARY}" --version RESULT_VARIABLE CHECK_RESULT
                    OUTPUT_QUIET ERROR_QUIET TIMEOUT 10)
            if(CHECK_RESULT STREQUAL "0")
                file(READ "${PIGZ_BINARY}" PIGZ_HEX HEX)
                string(LENGTH "${PIGZ_HEX}" HEX_SIZE)
                math(EXPR PIGZ_SIZE "${HEX_SIZE} / 2")
                message(STATUS "Embedding optional C pigz (${PIGZ_SIZE} bytes)")
            endif()
        endif()
    endif()
    if(NOT PIGZ_SIZE)
        file(REMOVE "${PIGZ_BINARY}")
        message(WARNING "Optional pigz build failed; native zlib gzip fallback will be used.\n${CONFIGURE_ERROR}\n${BUILD_ERROR}")
    endif()
endif()
if(PIGZ_SIZE)
    string(REGEX REPLACE "(..)" "0x\\1," PIGZ_ARRAY "${PIGZ_HEX}")
else()
    set(PIGZ_ARRAY "0")
endif()
file(WRITE "${OUTPUT}" "#include <cstddef>\nnamespace native {\nextern const unsigned char bundled_pigz[] = {${PIGZ_ARRAY}};\nextern const size_t bundled_pigz_size = ${PIGZ_SIZE};\n}\n")
